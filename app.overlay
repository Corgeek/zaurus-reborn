/* Bluetooth through a USB dongle on the USB host port */
/ {
    chosen {
        zephyr,bt-hci = &bt_hci_usbh;
    };

    bt_hci_usbh: bt-hci-usbh {
        compatible = "zephyr,bt-hci-usbh";
        status = "okay";
    };
};
